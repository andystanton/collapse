{
  "name": "collapse",
  "version": "2.0.0",
  "description": "Collapse DOM elements into WebGL representations of their pixels",
  "type": "module",
  "main": "dist/collapse.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node app/index.js",
    "stop": "pkill -f 'node app/index.js'",
    "typecheck": "tsc --noEmit"
  },
  "repository": "https://github.com/andystanton/collapse",
  "keywords": [
    "webgl",
    "animation",
    "dom",
    "pixels",
    "three.js"
  ],
  "author": "Andy Stanton",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^4.21.0",
    "html2canvas": "^1.4.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
